msgid "AdGuard Portal"
msgstr "Portail AdGuard"

msgid "Personal DNS-over-HTTPS"
msgstr "DNS-sur-HTTPS personnel"

msgid "Logout"
msgstr "Déconnexion"

msgid "Your Devices"
msgstr "Vos appareils"

msgid "Each device receives an isolated, authenticated DoH endpoint with custom filtering."
msgstr "Chaque appareil dispose d'un point de terminaison DoH isolé et authentifié avec filtrage sur mesure."

msgid "Add Device"
msgstr "Ajouter un appareil"

msgid "You have reached the maximum device quota"
msgstr "Vous avez atteint le quota maximal d'appareils"

msgid "Delete an inactive device to add another."
msgstr "Supprimez-en un inactif pour continuer."

msgid "No devices configured yet"
msgstr "Aucun appareil configuré pour le moment"

msgid "Register your phone, tablet, laptop, or home browser to obtain your secure DoH URL."
msgstr "Enregistrez votre smartphone, tablette ou ordinateur pour obtenir votre URL DoH sécurisée."

msgid "Register Your First Device"
msgstr "Enregistrez votre premier appareil"

msgid "Ad & Tracker Blocking"
msgstr "Blocage des publicités et traceurs"

msgid "SafeSearch Enforced"
msgstr "SafeSearch activé"

msgid "Parental Control"
msgstr "Contrôle parental"

msgid "Rules"
msgstr "Règles"

msgid "Setup Guide"
msgstr "Guide d'installation"

msgid "Delete Device"
msgstr "Supprimer l'appareil"

msgid "Are you sure you want to delete this device? This will revoke its DoH access."
msgstr "Êtes-vous sûr de vouloir supprimer cet appareil ? Son accès DoH sera révoqué."

msgid "Connect"
msgstr "Connecter"

msgid "Device Token:"
msgstr "Jeton d'appareil :"

msgid "Your Personalized DoH URL"
msgstr "Votre URL DoH personnalisée"

msgid "Copy"
msgstr "Copier"

msgid "Copied"
msgstr "Copié"

msgid "Apple iOS & macOS (1-Click Profile)"
msgstr "Apple iOS & macOS (Profil en 1 clic)"

msgid "Installs native encrypted DNS without installing any third-party apps."
msgstr "Installe le DNS chiffré natif sans nécessiter d'application tierce."

msgid "Download .mobileconfig"
msgstr "Télécharger .mobileconfig"

msgid "Android (Private DNS)"
msgstr "Android (DNS privé)"

msgid "Settings → Network & internet → Private DNS → Custom hostname:"
msgstr "Paramètres → Réseau & Internet → DNS privé → Nom d'hôte :"

msgid "Chrome, Firefox & Edge (Secure DNS)"
msgstr "Chrome, Firefox & Edge (DNS sécurisé)"

msgid "Browser Settings → Privacy & Security → Use Secure DNS → Custom provider: paste the personalized DoH URL above."
msgstr "Paramètres du navigateur → Confidentialité et sécurité → Utiliser un DNS sécurisé → Fournisseur personnalisé."

msgid "Done"
msgstr "Terminé"

msgid "Customize Filtering"
msgstr "Personnaliser le filtrage"

msgid "Tune blocked services and domain overrides"
msgstr "Ajuster les services bloqués et les exceptions de domaines"

msgid "Block Pre-configured Services"
msgstr "Bloquer des services prédéfinis"

msgid "One-click blocking evaluated directly by AdGuard Home with zero performance loss."
msgstr "Blocage en un clic directement évalué par AdGuard Home sans dégradation de performance."

msgid "Custom Blocked Domains"
msgstr "Domaines personnalisés bloqués"

msgid "Blocks specific domains exclusively on this device (e.g. distracting-site.com)."
msgstr "Bloque des domaines spécifiques exclusivement sur cet appareil."

msgid "Allowlist Overrides"
msgstr "Exceptions autorisées"

msgid "Unblocks domains that might be blocked by global AdGuard filter lists."
msgstr "Débloque les domaines qui pourraient être filtrés par les listes globales."

msgid "Add"
msgstr "Ajouter"

msgid "Cancel"
msgstr "Annuler"

msgid "Applying..."
msgstr "Application..."

msgid "Save Settings"
msgstr "Enregistrer"

msgid "Add New Device"
msgstr "Ajouter un nouvel appareil"

msgid "Device Name"
msgstr "Nom de l'appareil"

msgid "e.g. Dominic's iPhone or Work Laptop"
msgstr "ex. Mon iPhone ou Ordinateur portable"

msgid "A unique DoH URL token will be automatically assigned to this device."
msgstr "Un jeton DoH unique sera automatiquement attribué à cet appareil."

msgid "Registering..."
msgstr "Enregistrement..."

msgid "Register Device"
msgstr "Enregistrer l'appareil"

msgid "Sign in with"
msgstr "Se connecter avec"

msgid "Zero-trust encrypted DNS. Only authorized accounts authenticated via your identity provider can register devices and query DoH."
msgstr "DNS chiffré Zero-Trust. Seuls les comptes authentifiés auprès de votre fournisseur d'identité peuvent configurer des appareils."

msgid "Quick Login as Developer"
msgstr "Connexion rapide développeur"

msgid "Dev Mode Enabled"
msgstr "Mode développeur activé"

msgid "Connecting to AdGuard Portal..."
msgstr "Connexion au portail AdGuard..."

msgid "AdGuard DoH Hostname:"
msgstr "Nom d'hôte AdGuard DoH :"

msgid "Source Code on GitHub"
msgstr "Code source sur GitHub"
