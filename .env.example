# Server Port
PORT=8080

# SQLite database file path
DB_PATH=data/portal.db

# Public DoH domain served by your reverse proxy
DOH_DOMAIN=dns.example.com

# AdGuard Home Internal Admin Credentials & URL
AGH_URL=http://127.0.0.1:3000
AGH_USER=admin
AGH_PASSWORD=adguard_password

# OpenID Connect (OIDC) Configuration
# Works with any standard OIDC provider: Zitadel, Authentik, Keycloak, Authelia, Google, Okta, etc.
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=your_client_id
# Optional: Only needed if your IdP is configured as a Confidential/Web Client rather than a Public/SPA Client (PKCE)
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_PROVIDER_NAME=Single Sign-On

# Device limits & rules
MAX_DEVICES_PER_USER=10

# Dev Mode (set to true to enable one-click developer mock login for offline testing)
DEV_MODE=false
CORS_ORIGIN=*
