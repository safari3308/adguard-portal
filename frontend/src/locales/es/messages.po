msgid "AdGuard Portal"
msgstr "Portal AdGuard"

msgid "Personal DNS-over-HTTPS"
msgstr "DNS sobre HTTPS personal"

msgid "Logout"
msgstr "Cerrar sesión"

msgid "Your Devices"
msgstr "Tus dispositivos"

msgid "Each device receives an isolated, authenticated DoH endpoint with custom filtering."
msgstr "Cada dispositivo recibe un punto de enlace DoH aislado y autenticado con filtrado personalizado."

msgid "Add Device"
msgstr "Añadir dispositivo"

msgid "You have reached the maximum device quota"
msgstr "Has alcanzado la cuota máxima de dispositivos"

msgid "Delete an inactive device to add another."
msgstr "Elimina un dispositivo inactivo para añadir otro."

msgid "No devices configured yet"
msgstr "Aún no hay dispositivos configurados"

msgid "Register your phone, tablet, laptop, or home browser to obtain your secure DoH URL."
msgstr "Registra tu teléfono, tableta o portátil para obtener tu enlace DoH seguro."

msgid "Register Your First Device"
msgstr "Registra tu primer dispositivo"

msgid "Ad & Tracker Blocking"
msgstr "Bloqueo de publicidad y rastreo"

msgid "SafeSearch Enforced"
msgstr "Búsqueda segura obligatoria"

msgid "Parental Control"
msgstr "Control parental"

msgid "Rules"
msgstr "Reglas"

msgid "Setup Guide"
msgstr "Guía de conexión"

msgid "Delete Device"
msgstr "Eliminar dispositivo"

msgid "Are you sure you want to delete this device? This will revoke its DoH access."
msgstr "¿Estás seguro de que deseas eliminar este dispositivo? Se revocará su acceso a DoH."

msgid "Connect"
msgstr "Conectar"

msgid "Device Token:"
msgstr "Token del dispositivo:"

msgid "Your Personalized DoH URL"
msgstr "Tu URL DoH personalizada"

msgid "Copy"
msgstr "Copiar"

msgid "Copied"
msgstr "Copiado"

msgid "Apple iOS & macOS (1-Click Profile)"
msgstr "Apple iOS y macOS (Perfil en 1 clic)"

msgid "Installs native encrypted DNS without installing any third-party apps."
msgstr "Instala DNS cifrado nativo sin instalar aplicaciones de terceros."

msgid "Download .mobileconfig"
msgstr "Descargar .mobileconfig"

msgid "Android (Private DNS)"
msgstr "Android (DNS privado)"

msgid "Settings → Network & internet → Private DNS → Custom hostname:"
msgstr "Ajustes → Redes e Internet → DNS privado → Nombre de host:"

msgid "Chrome, Firefox & Edge (Secure DNS)"
msgstr "Chrome, Firefox y Edge (DNS seguro)"

msgid "Browser Settings → Privacy & Security → Use Secure DNS → Custom provider: paste the personalized DoH URL above."
msgstr "Ajustes del navegador → Privacidad y seguridad → Usar DNS seguro → Proveedor personalizado: pega la URL anterior."

msgid "Done"
msgstr "Listo"

msgid "Customize Filtering"
msgstr "Personalizar filtrado"

msgid "Tune blocked services and domain overrides"
msgstr "Ajustar servicios bloqueados y excepciones de dominios"

msgid "Block Pre-configured Services"
msgstr "Bloquear servicios preconfigurados"

msgid "One-click blocking evaluated directly by AdGuard Home with zero performance loss."
msgstr "Bloqueo con un clic procesado directamente por AdGuard Home sin pérdida de rendimiento."

msgid "Custom Blocked Domains"
msgstr "Dominios bloqueados personalizados"

msgid "Blocks specific domains exclusively on this device (e.g. distracting-site.com)."
msgstr "Bloquea dominios específicos exclusivamente en este dispositivo."

msgid "Allowlist Overrides"
msgstr "Excepciones permitidas"

msgid "Unblocks domains that might be blocked by global AdGuard filter lists."
msgstr "Desbloquea dominios bloqueados por las listas globales de AdGuard."

msgid "Add"
msgstr "Añadir"

msgid "Cancel"
msgstr "Cancelar"

msgid "Applying..."
msgstr "Guardando..."

msgid "Save Settings"
msgstr "Guardar ajustes"

msgid "Add New Device"
msgstr "Añadir nuevo dispositivo"

msgid "Device Name"
msgstr "Nombre del dispositivo"

msgid "e.g. Dominic's iPhone or Work Laptop"
msgstr "ej. Mi iPhone o Portátil de trabajo"

msgid "A unique DoH URL token will be automatically assigned to this device."
msgstr "Se asignará automáticamente un token DoH único a este dispositivo."

msgid "Registering..."
msgstr "Registrando..."

msgid "Register Device"
msgstr "Registrar dispositivo"

msgid "Sign in with"
msgstr "Iniciar sesión con"

msgid "Zero-trust encrypted DNS. Only authorized accounts authenticated via your identity provider can register devices and query DoH."
msgstr "DNS cifrado Zero-trust. Solo cuentas autenticadas mediante tu proveedor de identidad pueden registrar dispositivos."

msgid "Quick Login as Developer"
msgstr "Inicio de sesión rápido para desarrolladores"

msgid "Dev Mode Enabled"
msgstr "Modo desarrollador activado"

msgid "Connecting to AdGuard Portal..."
msgstr "Conectando al Portal AdGuard..."

msgid "AdGuard DoH Hostname:"
msgstr "Nombre de host AdGuard DoH:"

msgid "Source Code on GitHub"
msgstr "Código fuente en GitHub"
